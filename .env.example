# Copie este arquivo para .env.local e preencha os valores
# NUNCA suba o .env.local para o GitHub

# Google Sheets API Key
# Crie em: https://console.cloud.google.com → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_API_KEY=sua_api_key_aqui

# ID da sua planilha Google Sheets
# É a parte da URL: docs.google.com/spreadsheets/d/ESTE_ID_AQUI/edit
NEXT_PUBLIC_SHEET_ID=id_da_sua_planilha_aqui
